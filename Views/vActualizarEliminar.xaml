<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eClavijoS5.Views.vActualizarEliminar"
             Title="vActualizarEliminar">
    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        BackgroundColor="White">

        <Label Text="ACTUALIZAR / ELIMINAR ESTUDIANTE"
           FontSize="18"
           FontAttributes="Bold"
           TextColor="#0369A1"
           HorizontalTextAlignment="Center"
           VerticalOptions="Center"
           HorizontalOptions="Center" />

        <Grid ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="CÓDIGO"
       FontSize="14"
       FontAttributes="Bold"
       TextColor="#0369A1"
       VerticalOptions="Center"
       Grid.Row="0"
       Grid.Column="0" />
            
            <Entry x:Name="txtCodigo"
                IsEnabled="False"
           PlaceholderColor="#7DD3FC"
           TextColor="#0369A1"
           BackgroundColor="Transparent"
                Grid.Row="0"
                Grid.Column="1" />

            <Label Text="NOMBRE"
        FontSize="14"
       FontAttributes="Bold"
       TextColor="#0369A1"
       VerticalOptions="Center"
                Grid.Row="1"
                Grid.Column="0" />
            
            <Entry x:Name="txtNombre"
                   PlaceholderColor="#7DD3FC"
           TextColor="#0369A1"
           BackgroundColor="Transparent"
                Placeholder="MODIFICA EL NOMBRE"
                Grid.Row="1"
                Grid.Column="1" />
            
            <Label Text="APELLIDO"
       FontSize="14"
       FontAttributes="Bold"
       TextColor="#0369A1"
       VerticalOptions="Center"
                Grid.Row="2"
                Grid.Column="0" />
            
            <Entry x:Name="txtApellido"
                   PlaceholderColor="#7DD3FC"
           TextColor="#0369A1"
           BackgroundColor="Transparent"
                Placeholder="MODIFICA EL APELLIDO"
                Grid.Row="2"
                Grid.Column="1" />
            
            <Label Text="EDAD"
       FontSize="14"
       FontAttributes="Bold"
       TextColor="#0369A1"
       VerticalOptions="Center"
                Grid.Row="3"
                Grid.Column="0" />
            
            <Entry x:Name="txtEdad"
                   PlaceholderColor="#7DD3FC"
           TextColor="#0369A1"
           BackgroundColor="Transparent"
                Placeholder="MODIFICA LA EDAD"
                Grid.Row="3"
                Grid.Column="1" />
        </Grid>
        <Grid ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnActualizar"
 Text="Actualizar"
                    BackgroundColor="#38BDF8"
            TextColor="#0C4A6E"
            FontAttributes="Bold"
            FontSize="15"
 Grid.Row="0"
 Grid.Column="0"
 Clicked="btnActualizar_Clicked" />
            
            
            <Button x:Name="btnEliminar"
 Text="Eliminar"
            BackgroundColor="#38BDF8"
            TextColor="#0C4A6E"
            FontAttributes="Bold"
            FontSize="15"
 Grid.Row="0"
 Grid.Column="1"
 Clicked="btnEliminar_Clicked" />
        </Grid>




    </VerticalStackLayout>
</ContentPage>