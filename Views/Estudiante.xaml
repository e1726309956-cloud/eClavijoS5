<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eClavijoS5.Views.Estudiante"
             Title="Estudiante">

    <VerticalStackLayout Padding="15">

        <Label Text="Lista de Estudiantes"
           FontSize="22"
           FontAttributes="Bold"
           TextColor="#1E3A8A"
           HorizontalOptions="Center"
           Margin="0,0,0,10"/>

        <!-- Cabecera -->
        <Grid BackgroundColor="#2563EB"
          Padding="8"
          ColumnSpacing="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <Label Text="Código"
               TextColor="White"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Grid.Column="0"/>

            <Label Text="Nombre"
               TextColor="White"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Grid.Column="1"/>

            <Label Text="Apellido"
               TextColor="White"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Grid.Column="2"/>

            <Label Text="Edad"
               TextColor="White"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Grid.Column="3"/>
        </Grid>

        <ListView x:Name="listaEstudiante"
              HasUnevenRows="True"
              SeparatorVisibility="Default">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>

                        <Frame Margin="0,2"
                           Padding="5"
                           BorderColor="#D1D5DB"
                           CornerRadius="8"
                           HasShadow="False">

                            <Grid ColumnSpacing="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding codigo}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="0"/>

                                <Label Text="{Binding nombre}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="1"/>

                                <Label Text="{Binding apellido}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="2"/>

                                <Label Text="{Binding edad}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="3"/>

                            </Grid>

                        </Frame>

                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </VerticalStackLayout>


</ContentPage>